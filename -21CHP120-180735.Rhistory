# Define a function to read and process each CSV file
read_and_process <- function(file_name) {
df <- read.csv(file_name, stringsAsFactors = FALSE)
return(df)
}
# Read CSV files from the local computer
df1 <- read_and_process("buenos-aires-real-estate-1 - Sheet1.csv")
df2 <- read_and_process("buenos-aires-real-estate-2 - Sheet1.csv")
df3 <- read_and_process("buenos-aires-real-estate-3 - Sheet1.csv")
df4 <- read_and_process("buenos-aires-real-estate-4 - Sheet1.csv")
df5 <- read_and_process("buenos-aires-real-estate-5 - Sheet1.csv")
# Combine all dataframes
all_data <- rbind(df1, df2, df3, df4, df5)
print(str(all_data))
# Filter for apartments in Buenos Aires (Capital Federal)
data_apartments <- all_data %>%
filter(property_type == 'apartment' & grepl('Capital Federal', place_with_parent_names))
# Process the lat.lon column by splitting into 'lat' and 'lon'
data_apartments <- data_apartments %>%
separate(lat.lon, into = c('lat', 'lon'), sep = ',', convert = TRUE, extra = 'drop', fill = 'right')
# Extract neighborhood from place_with_parent_names
data_apartments <- data_apartments %>%
mutate(neighborhood = sapply(strsplit(as.character(place_with_parent_names), '\\\\|'), function(x) {
# Remove empty strings
x_clean <- x[nchar(x) > 0]
# If we have enough elements, take the third element (neighborhood) else NA
if(length(x_clean) >= 3){
return(x_clean[3])
} else {
return(NA)
}
}))
# Remove rows with missing key variables
data_apartments <- data_apartments %>%
filter(!is.na(price_aprox_usd),
!is.na(surface_covered_in_m2),
!is.na(lat),
!is.na(lon),
!is.na(neighborhood))
# Check the counts for each neighborhood
neighborhood_counts <- table(data_apartments$neighborhood)
print(neighborhood_counts)
# Identify neighborhoods with only one observation
single_obs_neighborhoods <- names(neighborhood_counts[neighborhood_counts == 1])
print("Neighborhoods with only one observation:")
print(single_obs_neighborhoods)
# Remove neighborhoods with only one observation (if any)
if(length(single_obs_neighborhoods) > 0) {
data_apartments <- data_apartments %>%
filter(!(neighborhood %in% single_obs_neighborhoods))
}
# Convert neighborhood to factor
data_apartments$neighborhood <- as.factor(data_apartments$neighborhood)
# Check the structure and number of levels for the neighborhood factor
print(str(data_apartments[, c('price_aprox_usd', 'surface_covered_in_m2', 'lat', 'lon', 'neighborhood')]))
print(paste("Number of levels in neighborhood factor:", nlevels(data_apartments$neighborhood)))
# Fit the multiple linear regression model
model <- lm(price_aprox_usd ~ surface_covered_in_m2 + lat + lon + neighborhood, data = data_apartments)
# Load necessary libraries
library(dplyr)
library(ggplot2)
library(tidyr)
library(stringr)
library(car)
library(corrplot)
# Load necessary packages using pacman
pacman::p_load(tidyverse, readxl, rio, ggrepel, viridis, ggtext, scales, Lahman, nycflights13, priceR, lubridate, riem, stringr, pander, caret, glmnet, shiny, corrplot)
# Read CSV files from the local computer
df1 <- read.csv("buenos-aires-real-estate-1 - Sheet1.csv", stringsAsFactors = FALSE)
df2 <- read.csv("buenos-aires-real-estate-2 - Sheet1.csv", stringsAsFactors = FALSE)
df3 <- read.csv("buenos-aires-real-estate-3 - Sheet1.csv", stringsAsFactors = FALSE)
df4 <- read.csv("buenos-aires-real-estate-4 - Sheet1.csv", stringsAsFactors = FALSE)
df5 <- read.csv("buenos-aires-real-estate-5 - Sheet1.csv", stringsAsFactors = FALSE)
# Combine all dataframes
all_data <- rbind(df1, df2, df3, df4, df5)
# Filter for apartments in Buenos Aires (Capital Federal)
data_apartments <- all_data %>%
filter(property_type == 'apartment' & grepl('Capital Federal', place_with_parent_names))
# Process the lat.lon column by splitting into 'lat' and 'lon'
data_apartments <- data_apartments %>%
separate(lat.lon, into = c('lat', 'lon'), sep = ',', convert = TRUE, extra = 'drop', fill = 'right')
# Remove rows with missing key variables
data_apartments <- data_apartments %>%
filter(!is.na(price_aprox_usd),
!is.na(surface_covered_in_m2),
!is.na(lat),
!is.na(lon))
# Fit the multiple linear regression model WITHOUT neighborhood
model <- lm(price_aprox_usd ~ surface_covered_in_m2 + lat + lon, data = data_apartments)
# Print the summary of the regression model
model_summary <- summary(model)
print(model_summary)
# ANOVA Table for the fitted model
anova_table <- anova(model)
print(anova_table)
# Check multicollinearity using Variance Inflation Factors (VIF)
vif_values <- car::vif(model)
print(vif_values)
# Diagnostic Plots
# Residuals vs Fitted plot
p1 <- ggplot(model, aes(.fitted, .resid)) +
geom_point() +
geom_hline(yintercept = 0, linetype = 'dashed', color = 'red') +
xlab('Fitted values') +
ylab('Residuals') +
ggtitle('Residuals vs Fitted')
print(p1)
# Normal Q-Q plot
p2 <- ggplot(model, aes(sample = .stdresid)) +
stat_qq() +
stat_qq_line() +
ggtitle('Normal Q-Q')
print(p2)
# Scale-Location plot
p3 <- ggplot(model, aes(.fitted, sqrt(abs(.stdresid)))) +
geom_point() +
geom_smooth(se = FALSE) +
xlab('Fitted values') +
ylab('Sqrt(|Standardized Residuals|)') +
ggtitle('Scale-Location')
print(p3)
# Plot Cook's Distance using base R's plot function
par(mfrow = c(1,1))
plot(model, which = 4, main = "Cook's Distance")
# Create a scatter plot of price vs surface area with a regression line
p4 <- ggplot(data_apartments, aes(x = surface_covered_in_m2, y = price_aprox_usd)) +
geom_point(alpha = 0.3) +
geom_smooth(method = "lm", col = "red") +
labs(title = "Price vs Surface Area",
x = "Surface Area (m²)",
y = "Price (USD)") +
theme_minimal()
print(p4)
# Create a heatmap of property prices by location
p5 <- ggplot(data_apartments, aes(x = lon, y = lat, color = price_aprox_usd)) +
geom_point(alpha = 0.5) +
scale_color_gradient(low = "blue", high = "red", name = "Price (USD)") +
labs(title = "Property Prices by Location in Buenos Aires",
x = "Longitude",
y = "Latitude") +
theme_minimal()
print(p5)
# Correlation matrix
cor_matrix <- cor(data_apartments[, c('price_aprox_usd', 'surface_covered_in_m2', 'lat', 'lon')],
use = "complete.obs")
print(cor_matrix)
# Create a correlation plot
corrplot(cor_matrix, method = "circle", type = "upper",
tl.col = "black", tl.srt = 45,
title = "Correlation Matrix of Numeric Variables")
